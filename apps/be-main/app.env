# App module: be-main (source: tjm-thomas/2026-kanso-be-main)
# Read by scripts/setup.sh. The templates in base/ use these values.

# Image built by the app repo, tagged with the git tree hash of its content
IMAGE_REPO=ghcr.io/tjm-thomas/2026-kanso-be-main
# Image used only when the app is first added to an environment.
# After that, the running image is kept and only ci/deploy.sh changes it.
INITIAL_IMAGE=ghcr.io/tjm-thomas/2026-kanso-be-main:22518e2d042f

PATH_PREFIX=/api
PORT=8080
HEALTH_PATH=/api/status
REPLICAS_STAGING=1
REPLICAS_PROD=2
# Hard memory cap per pod (default 128Mi). Spring Boot uses ~105Mi under light load; the JVM heap
# is sized to 60% of this limit (MaxRAMPercentage in the image).
MEMORY_LIMIT=384Mi
