# App module: fe-main-user (source: tjm-thomas/2026-kanso-fe-main-user)
# Read by scripts/setup.sh. The templates in base/ use these values.

# Image built by the app repo, tagged with the git tree hash of its content
IMAGE_REPO=ghcr.io/tjm-thomas/2026-kanso-fe-main-user
# Image used only when the app is first added to an environment.
# After that, the running image is kept and only ci/deploy.sh changes it.
INITIAL_IMAGE=ghcr.io/thomasjmtan/kanso-web:ddacc4c27710

PATH_PREFIX=/
PORT=80
HEALTH_PATH=/healthz
REPLICAS_STAGING=1
REPLICAS_PROD=2
