# App module: fe-dashboard (source: tjm-thomas/2026-kanso-fe-dashboard)
# Read by scripts/setup.sh. The templates in base/ use these values.

# Image built by the app repo, tagged with the git tree hash of its content
IMAGE_REPO=ghcr.io/tjm-thomas/2026-kanso-fe-dashboard
# Image used only when the app is first added to an environment.
# After that, the running image is kept and only ci/deploy.sh changes it.
INITIAL_IMAGE=ghcr.io/tjm-thomas/2026-kanso-fe-dashboard:0b116e35a986

PATH_PREFIX=/dashboard
PORT=80
HEALTH_PATH=/healthz
REPLICAS_STAGING=1
REPLICAS_PROD=2
# Hard memory cap per pod (default 128Mi). nginx serving static files uses ~10Mi.
MEMORY_LIMIT=64Mi
